# 生产环境覆盖项：复制为 .env.production（已被 gitignore）
# 启动前请 export APP_ENV=production，或在本文件设置并由进程加载

APP_ENV=production
LOG_LEVEL=INFO
LOG_DIR=/var/log/agent-backend

# MySQL 生产库（务必使用强密码 / 专用账号）
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=agent_backend
MYSQL_CHARSET=utf8mb4

# 推荐生产直接使用完整连接串（由密钥管理系统注入）
# MYSQL_URL=mysql+pymysql://user:password@host:3306/agent_backend?charset=utf8mb4

# JWT（生产必须设置强随机密钥，禁止使用示例值）
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

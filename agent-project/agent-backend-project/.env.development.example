# 开发环境覆盖项：复制为 .env.development（已被 gitignore）
APP_ENV=development
LOG_LEVEL=DEBUG

# MySQL 开发库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=agent_backend
MYSQL_CHARSET=utf8mb4

# JWT
JWT_SECRET_KEY=dev-jwt-secret-change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175

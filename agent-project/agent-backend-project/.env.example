# 复制为 .env 后按需修改；也可再复制 .env.development.example → .env.development
# 加载顺序：.env → .env.{APP_ENV}（后者覆盖前者）；进程环境变量优先级最高

APP_ENV=development

# 日志
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# MySQL（密码等敏感项只放本地 env，不要写进代码）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=agent_backend
MYSQL_CHARSET=utf8mb4

# 可选：完整 URL（填写后优先于上面分项）
# MYSQL_URL=mysql+pymysql://user:password@127.0.0.1:3306/agent_backend?charset=utf8mb4

# JWT（生产必须设置强随机密钥）
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS（逗号分隔；生产请改成真实前端域名）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175
